# Copy to .env and fill values. The system runs with NO keys using the operator's
# Gemini key below as the "free version"; users can override with their own key in Settings.

# Database (SQLite for local prototype; switch to postgres for production)
db_url=sqlite:///./data/app.db

# Auth
jwt_secret=change-me-to-a-long-random-string
jwt_algorithm=HS256
access_token_expire_minutes=10080

# Default free-tier LLM (operator Gemini key). Leave empty to force users to add their own.
gemini_api_key=
default_model_provider=gemini
default_model_name=gemini-2.5-flash

# Rate-limit safety (Gemini free tier ~15 RPM)
llm_min_interval_seconds=4.0
llm_max_retries=5
llm_concurrency=1

workspace_root=./workspace
cors_origins=http://localhost:3000

# --- Clerk (frontend auth: Google / GitHub / email+password) ---
# Your Clerk frontend API origin (from the Clerk dashboard), no trailing slash.
# The backend verifies Clerk JWTs against this issuer's public JWKS — no secret needed.
# Leave empty to disable Clerk (legacy email/password JWT auth still works).
clerk_issuer=
